{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OhMyAgent",
  "version": "2.1.0-beta1",
  "identifier": "com.ohmyagent.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:sidecar && node scripts/copy-pages.cjs",
    "devUrl": "http://127.0.0.1:9191/webui/?electron=1",
    "beforeBuildCommand": "pnpm bundle-deps && pnpm build:sidecar && node scripts/copy-pages.cjs",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../../dist": "sidecar/server-dist",
      "../../ui/dist": "sidecar/webui-dist",
      "../.sidecar-deps/node_modules": "sidecar/node_modules",
      "../.sidecar-deps/root": "sidecar",
      "../.sidecar-deps/runtime": "sidecar"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "compression": "zlib",
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
